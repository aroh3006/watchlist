# Database (SQLite by default for local dev; swap to Postgres for production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Metadata provider (adapter layer picks a provider at runtime)
# "local" uses the bundled seed dataset with no external calls.
# "tmdb" calls The Movie Database API (requires METADATA_TMDB_API_KEY).
METADATA_PROVIDER="local"
METADATA_TMDB_API_KEY=""

# Default timezone used for activity/streak calculations when a user
# has not set one explicitly.
DEFAULT_TIMEZONE="UTC"

# Upload limits (bytes) for the ZIP/CSV importer
IMPORT_MAX_UPLOAD_BYTES=52428800
